{
  "name": "kurnool-fitness-centre-core",
  "version": "1.0.0",
  "description": "Production REST API for Kurnool Fitness Centre — Full-Stack Gym Management & E-Commerce Platform",
  "author": "Kurnool Fitness Centre",
  "license": "MIT",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "psql \"$DATABASE_URL\" -f ../database/schema.sql",
