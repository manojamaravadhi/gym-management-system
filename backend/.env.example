# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon / Supabase / Render / Local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gym_management

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# CORS & Client URL (comma-separated or * in production)
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=*
